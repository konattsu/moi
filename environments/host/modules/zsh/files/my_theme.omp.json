{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .UserName }}@{{ .HostName }} in {{ .PWD }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "foreground": "#BBB",
          "template": "<d>{{ .UserName }}</d>"
        },
        {
          "type": "os",
          "style": "powerline",
          "foreground": "#BBB",
          "template": "<d>.{{ if .WSL }}w{{ else }}{{ if .Env.POSH_CONTAINER_KIND_SYMBOL }}{{ .Env.POSH_CONTAINER_KIND_SYMBOL }}{{ else }}.{{ end }}{{ end }}{{ .Env.POSH_DISTRO_ID_SYMBOL }}</d>"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#42FFFF",
          "template": " <u>{{ .Path }}</u>",
          "options": {
            "max_width": 30,
            "folder_separator_icon": "/",
            "style": "agnoster"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#C8C3DC",
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}s{{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }}",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": false
          }
        },
        {
          "type": "battery",
          "style": "powerline",
          "foreground": "#BBB",
          "template": "{{ if not .Error }} {{ if le .Percentage 10 }}<#E6325F>{{ .Icon }}{{ .Percentage }}%</>{{ else if le .Percentage 20 }}<#FFD728>{{ .Icon }}{{ .Percentage }}%</>{{ else }}<d>{{ .Icon }}{{ .Percentage }}%</d>{{ end }}{{ end }}",
          "options": {
            "discharging_icon": "",
            "charging_icon": "󰂄",
            "charged_icon": "",
            "not_charging_icon": ""
          }
        },
        {
          "type": "time",
          "style": "powerline",
          "foreground": "#BBB",
          "template": " <d>{{ .CurrentDate | date .Format }}</d>"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "#BBB",
          "template": " <d>{{ .FormattedMs }}</d>",
          "options": {
            "threshold": 500
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Error }}#FF8184{{ end }}",
            "{{ if not .Error }}#54A2E5{{ end }}"
          ],
          "template": "$",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
